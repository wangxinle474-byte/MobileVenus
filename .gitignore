# ============================================================
# 项目专属
# ============================================================

# ----- 模型权重 (大, 用 LFS 或单独分享) -----
# 只忽略权重文件本身, 保留训练日志/历史/配置, 方便协作 review
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/*.bin
checkpoints/**/*.safetensors
checkpoints/**/*.pkl

# ----- 训练 / 评估输出 (大, 可重新生成) -----
outputs/
# 但保留 README/说明文档, 方便他人了解每个 output 的含义
!outputs/**/README.md
!outputs/**/*.md
eval_results/

# ----- 训练曲线图 / 推理对比图 (本地生成) -----
images/training_curves/
images/inference/

# ----- 日志 -----
logs/
*.log
*.log.err
*.log.out
# 训练 stdout 重定向产物 (大, 可由 history.json 反推)
*_log.txt
training.log
# 仅 history.json / args.json / *.md 等元数据保留 (不被任何 ignore 规则命中)

# ----- 大数据文件 -----
# embeddings (npz, 几十 MB)
data/*.npz
# 生成的 pseudo-label 流水线产物
data/pseudo_labels/
data/sharegpt/
# 大的训练 manifest jsonl (>1MB, 可重新生成)
data/instruction_data.json
data/aug_final.json
data/aug_ip2p_full.json
